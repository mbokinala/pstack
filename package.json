{
  "name": "@mbokinala/pstack",
  "version": "0.2.1",
  "description": "Portable pstack workflows for Codex, Claude Code, and Cursor",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pstack": "bin/pstack.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "lib/installer.mjs",
    "dist/",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run build && npm run validate && npm test",
    "upstream:review": "node scripts/upstream.mjs review",
    "upstream:accept": "node scripts/upstream.mjs accept",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbokinala/pstack.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
